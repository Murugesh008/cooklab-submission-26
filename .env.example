# Copy this file to .env and fill in real values. Never commit .env itself.

# Local dev: sqlite:///./app.db
# Render (Postgres): use the "Internal Database URL" Render gives you, but
# swap "postgres://" for "postgresql://" at the start (SQLAlchemy needs this).
DATABASE_URL=sqlite:///./app.db

# Any long random string works for a hackathon. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_one

ACCESS_TOKEN_EXPIRE_MINUTES=1440
